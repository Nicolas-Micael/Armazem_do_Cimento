# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NUNCA deve ir para o repositório (está no .gitignore).

# Ambiente: development, test ou production
NODE_ENV=development

# Porta em que a API vai escutar
PORT=3333

# Endereço do frontend autorizado a chamar a API (CORS)
FRONTEND_URL=http://localhost:5173

# Conexão com o PostgreSQL local (o docker-compose.yml da raiz cria este banco)
DATABASE_URL=postgresql://armazem:armazem_dev@localhost:5432/armazem_dev?schema=public
