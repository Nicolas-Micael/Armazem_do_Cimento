// =============================================================
// Schema do banco de dados — Armazém do Cimento
// -------------------------------------------------------------
// Cada "model" vira uma tabela no PostgreSQL. Cada mudança neste
// arquivo deve gerar uma migration (npm run db:migrate), que é o
// histórico versionado das alterações do banco.
//
// Etapa 2: usuários, sessões de login e auditoria. As demais tabelas
// (clientes, produtos, pedidos, pagamentos...) entram nas etapas
// seguintes, conforme docs/planejamento-arquitetura.md, seção 5.
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Os dois únicos perfis do sistema (decisão de 25/11/2026).
enum Role {
  ADMIN
  FINANCEIRO
}

/// Usuário que acessa o sistema.
model User {
  id                 String    @id @default(uuid())
  name               String
  /// Nome de usuário para login, sempre em minúsculas (decisão de 26/11/2026).
  username           String    @unique
  /// Hash da senha (nunca a senha em texto puro). Ver src/lib/password.ts.
  passwordHash       String    @map("password_hash")
  role               Role
  /// true quando o ADM definiu uma senha temporária: o usuário precisa
  /// cadastrar uma senha nova antes de usar o sistema.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Usuários são desativados, não apagados, para preservar o histórico.
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  auditLogs          AuditLog[]
  ordersCreated      Order[]                @relation("OrderCreatedBy")
  orderStatusChanges OrderStatusHistory[]
  paymentsCreated    Payment[]              @relation("PaymentCreatedBy")
  paymentChanges     PaymentStatusHistory[]
  dueDatesCreated    OrderDueDate[]

  @@map("users")
}

/// Sessão de login. O navegador guarda um código aleatório num cookie;
/// aqui guardamos só o HASH desse código, para que um vazamento do
/// banco não permita entrar no sistema como outra pessoa.
model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Preenchido no logout, na troca/redefinição de senha ou ao desativar o usuário.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

/// Registro geral de alterações: quem fez, o quê, quando, antes e depois.
/// Nunca é editado nem apagado.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  /// Ex.: "user.create", "user.reset_password".
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================
// Etapa 4: clientes e produtos
// =============================================================

/// Cliente da distribuidora. Nunca é apagado: é desativado.
model Customer {
  id         String   @id @default(uuid())
  /// Nome ou razão social.
  name       String
  /// CPF (11 dígitos) ou CNPJ (14 dígitos), guardado só com números.
  /// Opcional por enquanto (pergunta P-CLI-2); se informado, não pode repetir.
  document   String?  @unique
  phone      String?
  /// Endereço único por cliente por enquanto (pergunta P-CLI-3).
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?  @db.Char(2)
  zipCode    String?  @map("zip_code")
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([name])
  @@map("customers")
}

/// Produto vendido (ex.: cimento CP II 50 kg). Nunca é apagado: é desativado.
model Product {
  id           String   @id @default(uuid())
  name         String
  brand        String?
  /// Tipo de cimento, ex.: "CP II-E-32", "CP V-ARI".
  cementType   String?  @map("cement_type")
  /// Unidade de venda. Inicialmente sempre "SACO".
  unit         String   @default("SACO")
  /// Preço de TABELA (pré-fixado). É só o valor sugerido: o preço muda com
  /// frequência e pode ser ajustado em cada pedido (regras a definir, P-PED-2).
  /// Cada item de pedido guardará o preço praticado, então mudar este valor
  /// não altera pedidos antigos.
  currentPrice Decimal  @map("current_price") @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([name])
  @@map("products")
}

// =============================================================
// Etapa 5: pedidos
// =============================================================

/// Situação operacional do pedido (independente da situação financeira).
enum OrderStatus {
  PENDING // Pendente
  CONFIRMED // Confirmado
  PICKING // Em separação
  OUT_FOR_DELIVERY // Saiu para entrega
  COMPLETED // Concluído
  CANCELLED // Cancelado
}

/// Condição de pagamento acordada na venda.
/// Tipo de operação. Só "Venda" por ora; novos tipos (bonificação, transferência...) entram como novos valores.
enum OrderOperationType {
  SALE // Venda
}

enum PaymentTerm {
  IMMEDIATE // À vista
  TERM_10_DAYS // A prazo: 10 dias
  TERM_15_DAYS // A prazo: 15 dias
  TERM_30_DAYS // A prazo: 30 dias
  NEGOTIATED // A prazo: negociado (vencimentos na etapa 7)
}

enum DeliveryMode {
  DELIVERY // Entrega
  PICKUP // Retirada pelo cliente
}

enum DiscountType {
  FIXED // Valor fixo em reais
  PERCENTAGE // Percentual
}

/// Pedido. Nunca é apagado: pedidos indevidos serão cancelados (etapa 6).
model Order {
  id                       String             @id @default(uuid())
  /// Número sequencial legível, exibido como PED-000123.
  number                   Int                @unique @default(autoincrement())
  customerId               String             @map("customer_id")
  customer                 Customer           @relation(fields: [customerId], references: [id])
  /// Nome e documento do cliente NA DATA do pedido (o cadastro pode mudar depois).
  customerNameSnapshot     String             @map("customer_name_snapshot")
  customerDocumentSnapshot String?            @map("customer_document_snapshot")
  status                   OrderStatus        @default(PENDING)
  operationType            OrderOperationType @default(SALE) @map("operation_type")

  /// Soma dos itens (quantidade × preço praticado).
  subtotal       Decimal       @db.Decimal(12, 2)
  freightAmount  Decimal       @default(0) @map("freight_amount") @db.Decimal(12, 2)
  discountType   DiscountType? @map("discount_type")
  /// Valor digitado: em reais (FIXED) ou em % (PERCENTAGE).
  discountValue  Decimal?      @map("discount_value") @db.Decimal(12, 2)
  /// Desconto já convertido em reais.
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// subtotal + frete − desconto. Calculado SEMPRE no backend.
  total          Decimal       @db.Decimal(12, 2)

  paymentTerm          PaymentTerm  @map("payment_term")
  deliveryMode         DeliveryMode @map("delivery_mode")
  deliveryAddress      String?      @map("delivery_address")
  /// Responsável pelo transporte (texto livre, P-ENT-2).
  deliveryResponsible  String?      @map("delivery_responsible")
  /// Logística em texto livre; cadastros próprios de motoristas/veículos ficam para um módulo futuro.
  driverName           String?      @map("driver_name")
  helperName           String?      @map("helper_name")
  vehicle              String?
  licensePlate         String?      @map("license_plate")
  /// Sacos efetivamente carregados (sem comparação automática com a quantidade vendida).
  loadedBags           Int?         @map("loaded_bags")
  expectedDeliveryDate DateTime?    @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime?    @map("actual_delivery_date") @db.Date
  deliveryNotes        String?      @map("delivery_notes")
  notes                String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  /// Aumenta a cada edição. Impede que duas pessoas salvem por cima uma da outra.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  dueDates      OrderDueDate[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Item do pedido. Guarda CÓPIAS do nome e dos preços do produto: mudar o
/// cadastro do produto depois não altera pedidos já feitos.
model OrderItem {
  id                  String        @id @default(uuid())
  orderId             String        @map("order_id")
  order               Order         @relation(fields: [orderId], references: [id])
  productId           String        @map("product_id")
  product             Product       @relation(fields: [productId], references: [id])
  /// Ordem do item no pedido (1, 2, 3...).
  position            Int
  productNameSnapshot String        @map("product_name_snapshot")
  unit                String
  /// Quantidade em sacos inteiros (P-PED-4, provisório).
  quantity            Int
  /// Preço de tabela no momento do pedido.
  catalogUnitPrice    Decimal       @map("catalog_unit_price") @db.Decimal(12, 2)
  /// Preço efetivamente praticado (pode ser diferente do de tabela).
  unitPrice           Decimal       @map("unit_price") @db.Decimal(12, 2)
  /// Desconto do item: valor digitado (R$ ou %) e o valor já convertido em reais.
  discountType        DiscountType? @map("discount_type")
  discountValue       Decimal?      @map("discount_value") @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// quantidade × preço praticado − desconto do item.
  lineTotal           Decimal       @map("line_total") @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

/// Histórico de mudanças de status: quem, quando, de qual para qual.
model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id])
  /// Vazio no registro de criação do pedido.
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String       @map("changed_by_id")
  changedBy   User         @relation(fields: [changedById], references: [id])
  changedAt   DateTime     @default(now()) @map("changed_at") @db.Timestamptz(3)
  note        String?

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Etapa D1 — Pagamentos (decisões em docs/decisoes/0008-pagamentos.md)
// ---------------------------------------------------------------------------

/// COMO o cliente pagou. Não é a conta onde o dinheiro entrou.
enum PaymentMethod {
  CASH // Dinheiro
  PIX
  CHECK // Cheque
  DEPOSIT // Depósito bancário
  DEBIT_CARD // Cartão de débito
  CREDIT_CARD // Cartão de crédito
  TRANSFER // Transferência bancária
}

/// Situação do pagamento. Só CONFIRMED conta como valor recebido.
enum PaymentStatus {
  PENDING // Pendente: registrado, falta conferir o recebimento
  TO_CLEAR // A compensar (cheque)
  CONFIRMED // Confirmado/compensado
  REVERSED // Estornado (definitivo)
}

/// Tipo de conta de destino.
enum ReceivingAccountKind {
  BANK // Conta bancária (Bradesco, Caixa Econômica)
  CASH_BOX // Caixa físico da empresa
  CHECK_WALLET // Carteira de cheques / recebimentos pendentes
}

/// ONDE o valor entrou. Cadastro de referência criado pela migração.
model ReceivingAccount {
  id        String               @id @default(uuid())
  /// Código estável usado pelo sistema (ex.: CASH_BOX).
  code      String               @unique
  name      String
  kind      ReceivingAccountKind
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  payments Payment[]

  @@map("receiving_accounts")
}

/// Pagamento de uma saída. NUNCA é apagado: correção = estorno + novo lançamento.
/// Totais (recebido, a compensar, saldo) não são gravados: são calculados dos pagamentos.
model Payment {
  id          String           @id @default(uuid())
  orderId     String           @map("order_id")
  order       Order            @relation(fields: [orderId], references: [id])
  method      PaymentMethod
  accountId   String           @map("account_id")
  account     ReceivingAccount @relation(fields: [accountId], references: [id])
  amount      Decimal          @db.Decimal(12, 2)
  /// Data do recebimento (dia de Brasília).
  receivedAt  DateTime         @map("received_at") @db.Date
  status      PaymentStatus
  /// Quando virou Confirmado (conferência ou compensação).
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  notes       String?

  /// Só para cheque (todos nulos nos outros meios; garantido por CHECK no banco).
  checkNumber           String?   @map("check_number")
  checkBank             String?   @map("check_bank")
  checkExpectedClearing DateTime? @map("check_expected_clearing") @db.Date

  createdById String   @map("created_by_id")
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  history PaymentStatusHistory[]

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([accountId])
  @@map("payments")
}

/// Cada mudança de situação (e de conta) de um pagamento: quem, quando, por quê.
model PaymentStatusHistory {
  id            String         @id @default(uuid())
  paymentId     String         @map("payment_id")
  payment       Payment        @relation(fields: [paymentId], references: [id])
  /// Vazio no registro do pagamento.
  fromStatus    PaymentStatus? @map("from_status")
  toStatus      PaymentStatus  @map("to_status")
  /// Preenchidos quando a conta muda (ex.: Carteira de cheques → Bradesco).
  fromAccountId String?        @map("from_account_id")
  toAccountId   String?        @map("to_account_id")
  changedById   String         @map("changed_by_id")
  changedBy     User           @relation(fields: [changedById], references: [id])
  changedAt     DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  /// Obrigatório no estorno.
  reason        String?

  @@index([paymentId])
  @@map("payment_status_history")
}

/// Vencimento de uma saída a prazo. Substituído (nunca apagado) quando redefinido.
model OrderDueDate {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id])
  /// 1º, 2º vencimento...
  sequence     Int
  dueDate      DateTime  @map("due_date") @db.Date
  amount       Decimal   @db.Decimal(12, 2)
  createdById  String    @map("created_by_id")
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Preenchido quando este vencimento foi substituído por outro conjunto.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  @@index([orderId])
  @@index([dueDate])
  @@map("order_due_dates")
}
